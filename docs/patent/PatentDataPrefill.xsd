<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="urn:patentstyret:patent:prefill"
    targetNamespace="urn:patentstyret:patent:prefill"
    elementFormDefault="qualified">

    <xs:annotation>
        <xs:documentation>
            Schema for prefilling patent application data.
            The primary integration format is JSON (application/json); this XSD is provided for reference.
            Namespace: urn:patentstyret:patent:prefill
        </xs:documentation>
    </xs:annotation>

    <!-- ==================== Simple Types (Enums) ==================== -->

    <xs:simpleType name="DividedOrDivisionalType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="divided"/>
            <xs:enumeration value="divisional"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CaseManagementLanguageType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="no"/>
            <xs:enumeration value="en"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="AgentOrApplicantType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="agent"/>
            <xs:enumeration value="applicant"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ReasonApplicantNotSameAsInventorType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="dealWithinventor"/>
            <xs:enumeration value="employeesInventionsAct"/>
            <xs:enumeration value="assignmentFromInventor"/>
            <xs:enumeration value="other"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="RoleType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="applicant"/>
            <xs:enumeration value="inventor"/>
            <xs:enumeration value="both"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PersonOrOrganizationType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="person"/>
            <xs:enumeration value="org"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ==================== Root Element ==================== -->

    <xs:element name="patentData-prefill" type="tns:PatentDataPrefill"/>

    <!-- ==================== Main Type ==================== -->

    <xs:complexType name="PatentDataPrefill">
        <xs:annotation>
            <xs:documentation>Root type for patent prefill data</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="contactEmail" type="xs:string" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Contact email address. Required.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="contactReference" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Contact reference. Used as contact information in some submitter scenarios.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="contactPhoneNumber" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Contact phone number. Used as contact information in some submitter scenarios.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="inquiryMessage" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Optional message or inquiry related to the application</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="inventionTitle" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Title of the invention. Required when pctApplicationNumber is provided.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="numberOfClaims" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Number of claims in the patent application</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:int">
                        <xs:minInclusive value="0"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="acceleratedApplication" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Whether this is an accelerated application</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="requestedCaseManagementLanguage" type="tns:CaseManagementLanguageType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Preferred language for case management: 'no' for Norwegian, 'en' for English</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="applicantPerformsMoreThan20ManYears" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Whether the applicant performs more than 20 man-years</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="pctApplicationNumber" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>PCT application number. When provided, pctApplicationDate and inventionTitle are required.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="pctApplicationDate" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Date of the PCT application (ISO 8601 format: YYYY-MM-DD). Required when pctApplicationNumber is provided.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="dividedOrDivisional" type="tns:DividedOrDivisionalType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Indicator for divided or divisional application type. When provided, divApplicationNumber and divApplicationDate are required.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="divApplicationNumber" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Application number for the divided or divisional application. Required when dividedOrDivisional is provided.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="divApplicationDate" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Date of the divided or divisional application (ISO 8601 format: YYYY-MM-DD). Required when dividedOrDivisional is provided.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="preliminarySearchReferenceNumber" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Reference number for the preliminary search</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="earlierApplications" type="tns:EarlierApplicationsList" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>List of earlier applications claiming priority</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="agentOrApplicant" type="tns:AgentOrApplicantType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Indicator whether the submitter is an agent or applicant.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="agentCustomerNumber" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Customer number for the agent. Optional. If omitted, it may be retrieved automatically for known customers. Must contain only digits when provided.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="reasonApplicantNotSameAsInventor" type="tns:ReasonApplicantNotSameAsInventorType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Reason why applicant is not the same as inventor.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="reasonApplicantNotSameAsInventorOtherExplanation" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Free-text explanation. Required when reasonApplicantNotSameAsInventor is 'other'. Must be omitted for any other value. (XSD cannot express this conditional.)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="applicantsAndInventors" type="tns:ApplicantsAndInventorsList" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>List of applicants and inventors associated with the patent. Valid combinations are role=applicant with personOrOrganization=person or org, and role=inventor or both with personOrOrganization=person only.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="submitter" type="tns:PrefillSubmitter" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Optional submitter identity. Used to populate requestor details in some submitter scenarios.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ==================== Earlier Applications List ==================== -->

    <xs:complexType name="EarlierApplicationsList">
        <xs:sequence>
            <xs:element name="PrefillEarlierApplication" type="tns:PrefillEarlierApplication" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ==================== Earlier Application Type ==================== -->

    <xs:complexType name="PrefillEarlierApplication">
        <xs:annotation>
            <xs:documentation>Represents an earlier application for priority claims</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="priorityDate" type="xs:string" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Priority date of the earlier application (ISO 8601 format: YYYY-MM-DD)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="country" type="xs:string" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Priority country or authority code. Use the returned value from the priorityCountries options endpoint; labels are display text only. The list may include authorities such as WIPO in addition to countries.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="caseId" type="xs:string" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Case identifier for the earlier application</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ==================== Applicants and Inventors List ==================== -->

    <xs:complexType name="ApplicantsAndInventorsList">
        <xs:sequence>
            <xs:element name="PrefillApplicantOrInventor" type="tns:PrefillApplicantOrInventor" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ==================== Applicant or Inventor Type ==================== -->

    <xs:complexType name="PrefillApplicantOrInventor">
        <xs:annotation>
            <xs:documentation>Represents an applicant or inventor in the patent application. role + personOrOrganization together determine the valid contract shape.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="role" type="tns:RoleType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Role in the application. 'applicant' may be used with person or org. 'inventor' and 'both' are valid only together with personOrOrganization='person'.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="personOrOrganization" type="tns:PersonOrOrganizationType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Entity type. 'person' requires firstName, lastName, and country. 'org' requires companyName and country, and also companyNumber when country is 'NO'. 'org' is invalid when role is 'inventor' or 'both'.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="firstName" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>First name. Required when personOrOrganization is 'person'.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="lastName" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Last name. Required when personOrOrganization is 'person'.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="companyName" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Company name. Required when personOrOrganization is 'org'.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="companyNumber" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Organization number. Required when personOrOrganization is 'org' and country is 'NO'. Must contain only digits when provided.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="dateOfBirth" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Date of birth in ISO yyyy-MM-dd format. Optional in this schema. May be required for Norwegian persons.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="streetAddress" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Street address</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="postalCode" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Postal/ZIP code</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="city" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>City name</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="country" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Country code. Use the returned value from the countries options endpoint in Swagger; labels are display text only.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ==================== Submitter Type ==================== -->

    <xs:complexType name="PrefillSubmitter">
        <xs:annotation>
            <xs:documentation>Optional submitter identity. Provide either firstName + lastName or companyName, together with streetAddress, postalCode, city, and country.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="firstName" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>First name. Used together with lastName for person submitters.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="lastName" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Last name. Used together with firstName for person submitters.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="companyName" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Company name. Alternative to firstName + lastName for organization submitters.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="dateOfBirth" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Date of birth in ISO yyyy-MM-dd format. Optional in this schema. May be required for Norwegian person submitters.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="streetAddress" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Street address</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="postalCode" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Postal/ZIP code</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="city" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>City name</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="country" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Country code. Use the returned value from the countries options endpoint in Swagger; labels are display text only.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>

